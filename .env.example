# Copy to .env for local development:  cp .env.example .env
# Every variable is validated at boot (apps/api/src/config/env.ts); the process
# refuses to start if a required value is missing or malformed.

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=4000

# Public URLs of the four web apps (CORS allowlist, per-app Origin checks, email links).
APP_URL_CUSTOMER=http://localhost:5173
APP_URL_RESTAURANT=http://localhost:5174
APP_URL_DELIVERY=http://localhost:5175
APP_URL_ADMIN=http://localhost:5176

# --- Auth (development values only — generate fresh secrets for any shared environment) ---
# Comma-separated kid:secret pairs (each secret >= 32 bytes). The first key signs
# access tokens; all listed keys verify them, which allows rotation.
JWT_SIGNING_KEYS=dev-2026-11:dev-only-signing-secret-change-me-0123456789
# HMAC key for OTP codes and identifier hashes (>= 32 bytes).
AUTH_HMAC_SECRET=dev-only-hmac-secret-change-me-0123456789abcdef
# Refresh cookies are Secure by default in production; plain-http localhost needs false.
COOKIE_SECURE=false
# Where OTPs and emails go without real providers: file (.local/dev-messages.log) or log.
DEV_MESSAGE_SINK=file
# Geocoding: mock (Bengaluru gazetteer, development) or none (manual map pin only). Production defaults to none (OD-13).
GEO_PROVIDER=mock

# --- Worker ---
WORKER_HEALTH_PORT=4001

# --- Data stores (match docker-compose.yml) ---
DATABASE_URL=postgresql://fos:fos_dev_password@localhost:5432/fos
TEST_DATABASE_URL=postgresql://fos:fos_dev_password@localhost:5432/fos_test
# Integration tests use this Redis database (it is flushed). Use a dedicated DB index.
TEST_REDIS_URL=redis://localhost:6379/15
# Scratch database Prisma replays migrations into (drift checks, migrate dev).
SHADOW_DATABASE_URL=postgresql://fos:fos_dev_password@localhost:5432/fos_shadow
# Without Docker, infrastructure/scripts/local-postgres.sh serves these on port 5433.
REDIS_CORE_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380
# Without Docker, infrastructure/scripts/local-redis.sh serves these on ports 6390/6391.

# --- Object storage (FR-FILE-005) ---
# local = files under STORAGE_LOCAL_DIR served by the API (default outside production);
# s3 = S3-compatible (SeaweedFS S3 gateway via Docker in development, S3/R2 in production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local/storage
# How browsers reach the API (signed file links, local media). Required (https) in production.
API_PUBLIC_URL=http://localhost:4000
# Optional CDN base for public media.
# PUBLIC_MEDIA_BASE_URL=
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ACCESS_KEY=fos_storage
STORAGE_SECRET_KEY=fos_storage_dev_password
STORAGE_PUBLIC_BUCKET=fos-public-media
STORAGE_PRIVATE_BUCKET=fos-private-docs

# --- Email (Mailpit in development) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Payments (FR-PAY-001) ---
# mock = in-memory provider for development (never in production); razorpay needs the three keys below.
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Comma-separated: list old and new secrets while rotating.
# RAZORPAY_WEBHOOK_SECRETS=
