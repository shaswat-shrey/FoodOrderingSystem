{
  "name": "@fos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST API + Socket.IO gateway (modular monolith)",
  "exports": {
    "./platform": "./src/platform/index.ts",
    "./notifications": "./src/modules/notifications/index.ts",
    "./jobs": "./src/jobs/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@fos/db": "workspace:*",
    "@fos/shared": "workspace:*",
    "@fos/types": "workspace:*",
    "@fos/validation": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.81.5",
    "busboy": "1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "pino": "^9.14.0",
    "sharp": "0.34.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fos/config": "workspace:*",
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
