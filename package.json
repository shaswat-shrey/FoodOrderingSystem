{
  "name": "food-order-system",
  "private": true,
  "description": "Online food ordering and delivery platform (monorepo)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node docs/tools/requirements-index.mjs --check",
    "docs:index": "node docs/tools/requirements-index.mjs",
    "docs:api": "pnpm --filter @fos/api exec tsx ../../docs/tools/openapi.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
