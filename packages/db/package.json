{
  "name": "@fos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, seed and database client factory",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema",
    "db:validate": "prisma validate --schema prisma/schema",
    "db:format": "prisma format --schema prisma/schema",
    "db:migrate": "prisma migrate dev --schema prisma/schema --create-only",
    "db:deploy": "prisma migrate deploy --schema prisma/schema",
    "db:status": "prisma migrate status --schema prisma/schema",
    "db:seed": "tsx src/seed/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:drift": "prisma migrate diff --from-migrations prisma/schema/migrations --to-schema-datamodel prisma/schema --shadow-database-url $SHADOW_DATABASE_URL --exit-code"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@fos/config": "workspace:*",
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "typescript": "~5.9.3"
  }
}
