// Cart, checkout, pricing configuration, coupons, promotions, merchandising (SRS §15.3.5).

enum CartStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  ABANDONED
}

enum CheckoutSessionStatus {
  OPEN
  CONFIRMED
  EXPIRED
}

enum PriceComponent {
  FOOD
  PACKAGING
  DELIVERY_FEE
  PLATFORM_FEE
  SMALL_ORDER_FEE
  SURGE_FEE
}

enum TaxCode {
  GST
  CGST
  SGST
  IGST
}

enum TaxCollector {
  PLATFORM
  RESTAURANT
}

enum DiscountType {
  FLAT
  PERCENT
  FREE_DELIVERY
}

enum UserSegment {
  ALL
  NEW_USERS
  TARGETED
}

enum DiscountFunding {
  PLATFORM
  RESTAURANT
  SHARED
}

enum CouponVisibility {
  PUBLIC
  HIDDEN
}

enum CouponStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum RedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum PromotionScope {
  PLATFORM
  RESTAURANT
}

enum PromotionType {
  PERCENT_OFF
  FLAT_OFF
  FREE_DELIVERY
  BOGO
}

enum PromotionStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ENDED
}

/// SQL: partial unique — one ACTIVE cart per user (BR-CART-001).
model Cart {
  id             String     @id @default(uuid(7)) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  branchId       String?    @map("branch_id") @db.Uuid
  status         CartStatus @default(ACTIVE)
  couponId       String?    @map("coupon_id") @db.Uuid
  instructions   String?    @db.VarChar(250)
  noCutlery      Boolean    @default(false) @map("no_cutlery")
  lastActivityAt DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  version        Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coupon           Coupon?           @relation(fields: [couponId], references: [id], onDelete: Restrict)
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([userId, status])
  @@index([status, lastActivityAt])
  @@map("carts")
}

/// Line identity = config_hash of (item, variant, sorted options, instructions) — BR-CART-004.
/// SQL: CHECK quantity 1–20.
model CartItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  cartId         String   @map("cart_id") @db.Uuid
  foodItemId     String   @map("food_item_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  quantity       Int
  instructions   String?  @db.VarChar(250)
  configHash     String   @map("config_hash") @db.Char(64)
  /// Unit price the customer last saw, to flag PRICE_CHANGED instead of silently repricing (BR-CART-005).
  unitAmountSeen Int?     @map("unit_amount_seen")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart     Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  foodItem FoodItem         @relation(fields: [foodItemId], references: [id])
  variant  FoodItemVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  options  CartItemOption[]

  @@unique([cartId, configHash])
  @@map("cart_items")
}

model CartItemOption {
  cartItemId String @map("cart_item_id") @db.Uuid
  optionId   String @map("option_id") @db.Uuid

  cartItem CartItem            @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  option   CustomizationOption @relation(fields: [optionId], references: [id])

  @@id([cartItemId, optionId])
  @@map("cart_item_options")
}

/// Priced snapshot of a cart (FR-CHK-001). `quote` is a cache: amounts are
/// recomputed at confirmation.
model CheckoutSession {
  id                   String                @id @default(uuid(7)) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  cartId               String                @map("cart_id") @db.Uuid
  cartHash             String                @map("cart_hash") @db.Char(64)
  addressId            String                @map("address_id") @db.Uuid
  paymentMethod        PaymentMethod         @map("payment_method")
  useWallet            Boolean               @default(false) @map("use_wallet")
  tipAmount            Int                   @default(0) @map("tip_amount")
  deliveryInstructions String?               @map("delivery_instructions") @db.VarChar(200)
  contactless          Boolean               @default(false)
  contactName          String?               @map("contact_name") @db.VarChar(80)
  contactPhone         String?               @map("contact_phone") @db.VarChar(16)
  quote                Json
  payableAmount        Int                   @map("payable_amount")
  feeScheduleId        String                @map("fee_schedule_id") @db.Uuid
  status               CheckoutSessionStatus @default(OPEN)
  expiresAt            DateTime              @map("expires_at") @db.Timestamptz(3)
  version              Int                   @default(0)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User            @relation(fields: [userId], references: [id])
  cart        Cart            @relation(fields: [cartId], references: [id])
  address     CustomerAddress @relation(fields: [addressId], references: [id])
  feeSchedule FeeSchedule     @relation(fields: [feeScheduleId], references: [id])
  order       Order?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

/// Effective-dated fee configuration (FR-CFG-002, BR-PRICE-003..007). Null zone = platform default.
model FeeSchedule {
  id                         String   @id @default(uuid(7)) @db.Uuid
  zoneId                     String?  @map("zone_id") @db.Uuid
  platformFeeAmount          Int      @map("platform_fee_amount")
  smallOrderThresholdAmount  Int      @map("small_order_threshold_amount")
  smallOrderFeeAmount        Int      @map("small_order_fee_amount")
  perKmBeyondSlabsAmount     Int      @map("per_km_beyond_slabs_amount")
  packagingCapPerItemAmount  Int      @map("packaging_cap_per_item_amount")
  packagingCapPerOrderAmount Int      @map("packaging_cap_per_order_amount")
  surgeCapAmount             Int      @map("surge_cap_amount")
  effectiveFrom              DateTime @map("effective_from") @db.Timestamptz(3)
  createdBy                  String?  @map("created_by") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  zone             Zone?             @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  deliverySlabs    DeliveryFeeSlab[]
  checkoutSessions CheckoutSession[]
  orders           Order[]

  @@index([zoneId, effectiveFrom])
  @@map("fee_schedules")
}

/// SQL: CHECK to_m > from_m.
model DeliveryFeeSlab {
  feeScheduleId String @map("fee_schedule_id") @db.Uuid
  fromM         Int    @map("from_m")
  toM           Int    @map("to_m")
  feeAmount     Int    @map("fee_amount")

  feeSchedule FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)

  @@id([feeScheduleId, fromM])
  @@map("delivery_fee_slabs")
}

/// Effective-dated tax rate per price component (BR-PRICE-009; legal review pending).
model TaxRule {
  id            String         @id @default(uuid(7)) @db.Uuid
  component     PriceComponent
  taxCode       TaxCode        @map("tax_code")
  rateBps       Int            @map("rate_bps")
  collectedBy   TaxCollector   @map("collected_by")
  effectiveFrom DateTime       @map("effective_from") @db.Timestamptz(3)
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([component, effectiveFrom])
  @@map("tax_rules")
}

/// SQL: partial unique (code) among non-deleted; CHECK ends_at > starts_at;
/// CHECK used + reserved ≤ total limit (BR-COUPON-003).
model Coupon {
  id                       String           @id @default(uuid(7)) @db.Uuid
  code                     String           @db.Citext
  description              String           @db.VarChar(300)
  discountType             DiscountType     @map("discount_type")
  /// Paise for FLAT, basis points for PERCENT, unused for FREE_DELIVERY.
  value                    Int
  maxDiscountAmount        Int?             @map("max_discount_amount")
  minSubtotalAmount        Int              @default(0) @map("min_subtotal_amount")
  startsAt                 DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt                   DateTime         @map("ends_at") @db.Timestamptz(3)
  usageLimitTotal          Int?             @map("usage_limit_total")
  usageLimitPerUser        Int              @default(1) @map("usage_limit_per_user")
  usedCount                Int              @default(0) @map("used_count")
  reservedCount            Int              @default(0) @map("reserved_count")
  userSegment              UserSegment      @default(ALL) @map("user_segment")
  paymentMethodRestriction PaymentMethod?   @map("payment_method_restriction")
  funding                  DiscountFunding  @default(PLATFORM)
  restaurantShareBps       Int              @default(0) @map("restaurant_share_bps")
  stackableWithPromotion   Boolean          @default(false) @map("stackable_with_promotion")
  visibility               CouponVisibility @default(PUBLIC)
  status                   CouponStatus     @default(DRAFT)
  createdBy                String?          @map("created_by") @db.Uuid
  version                  Int              @default(0)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?        @map("deleted_at") @db.Timestamptz(3)

  restaurants CouponRestaurant[]
  zones       CouponZone[]
  users       CouponUser[]
  redemptions CouponRedemption[]
  carts       Cart[]
  orders      Order[]

  @@index([status, endsAt])
  @@map("coupons")
}

model CouponRestaurant {
  couponId     String @map("coupon_id") @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid

  coupon     Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@id([couponId, restaurantId])
  @@map("coupon_restaurants")
}

model CouponZone {
  couponId String @map("coupon_id") @db.Uuid
  zoneId   String @map("zone_id") @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  zone   Zone   @relation(fields: [zoneId], references: [id])

  @@id([couponId, zoneId])
  @@map("coupon_zones")
}

model CouponUser {
  couponId String @map("coupon_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@id([couponId, userId])
  @@map("coupon_users")
}

/// One redemption per order; RESERVED → REDEEMED | RELEASED (BR-COUPON-006).
model CouponRedemption {
  id             String           @id @default(uuid(7)) @db.Uuid
  couponId       String           @map("coupon_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  orderId        String           @unique @map("order_id") @db.Uuid
  status         RedemptionStatus @default(RESERVED)
  discountAmount Int              @map("discount_amount")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId, userId, status])
  @@map("coupon_redemptions")
}

model Promotion {
  id                String          @id @default(uuid(7)) @db.Uuid
  scope             PromotionScope
  restaurantId      String?         @map("restaurant_id") @db.Uuid
  title             String          @db.VarChar(120)
  type              PromotionType
  /// Paise for FLAT_OFF, basis points for PERCENT_OFF.
  value             Int
  maxDiscountAmount Int?            @map("max_discount_amount")
  minSubtotalAmount Int             @default(0) @map("min_subtotal_amount")
  startsAt          DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime        @map("ends_at") @db.Timestamptz(3)
  newCustomersOnly  Boolean         @default(false) @map("new_customers_only")
  funding           DiscountFunding
  status            PromotionStatus @default(DRAFT)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)

  restaurant Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branches   PromotionBranch[]
  items      PromotionItem[]

  @@index([restaurantId, status, endsAt])
  @@map("promotions")
}

model PromotionBranch {
  promotionId String @map("promotion_id") @db.Uuid
  branchId    String @map("branch_id") @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id])

  @@id([promotionId, branchId])
  @@map("promotion_branches")
}

model PromotionItem {
  promotionId String @map("promotion_id") @db.Uuid
  foodItemId  String @map("food_item_id") @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  foodItem  FoodItem  @relation(fields: [foodItemId], references: [id])

  @@id([promotionId, foodItemId])
  @@map("promotion_items")
}

model Banner {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String    @db.VarChar(120)
  imageFileId String    @map("image_file_id") @db.Uuid
  /// Internal app route only (FR-DISC-006).
  targetRoute String    @map("target_route") @db.VarChar(200)
  zoneId      String?   @map("zone_id") @db.Uuid
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(3)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  imageFile File  @relation("BannerImage", fields: [imageFileId], references: [id])
  zone      Zone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([zoneId, startsAt, endsAt])
  @@map("banners")
}

model Collection {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(60)
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  collectionId String @map("collection_id") @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@id([collectionId, restaurantId])
  @@map("collection_items")
}
