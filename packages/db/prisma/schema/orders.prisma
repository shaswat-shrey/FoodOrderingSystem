// Orders and immutable order snapshots (SRS §10, §15.3.6, ADR-006).

enum OrderStatus {
  PAYMENT_PENDING
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED
  REJECTED
  FAILED
}

enum OrderRefundStatus {
  NONE
  PENDING
  PARTIAL
  FULL
}

enum PaymentMethod {
  ONLINE
  COD
  WALLET
}

enum ActorType {
  CUSTOMER
  RESTAURANT
  PARTNER
  ADMIN
  SYSTEM
}

enum OrderFailureReason {
  PAYMENT_EXPIRED
  PAYMENT_FAILED
  DELIVERY_FAILED
  CUSTOMER_UNREACHABLE
  SYSTEM_ERROR
}

enum CancellationFault {
  CUSTOMER
  RESTAURANT
  PARTNER
  PLATFORM
  PAYMENT
}

enum OrderPriceComponentType {
  ITEMS_SUBTOTAL
  ITEM_DISCOUNT
  PROMOTION
  COUPON
  PACKAGING
  DELIVERY_FEE
  SURGE
  SMALL_ORDER_FEE
  PLATFORM_FEE
  TAX
  TIP
  WALLET
}

enum FundedBy {
  PLATFORM
  RESTAURANT
  SHARED
  CUSTOMER
}

enum OrderIssueType {
  MISSING_ITEM
  WRONG_ITEM
  QUALITY
  SPILLAGE
  LATE
  NOT_DELIVERED
  PAYMENT
  OTHER
}

enum OrderIssueStatus {
  OPEN
  APPROVED
  REJECTED
  RESOLVED
}

enum InvoiceIssuer {
  RESTAURANT
  PLATFORM
}

/// Order aggregate. Status changes only via the orders module's transition()
/// (§10.3). SQL: CHECK payable = total − wallet_applied, amounts ≥ 0, partial
/// index on non-terminal statuses.
model Order {
  id                   String              @id @default(uuid(7)) @db.Uuid
  /// Human-readable, non-sequential (FR-ORDER-003).
  number               String              @unique @db.VarChar(16)
  userId               String              @map("user_id") @db.Uuid
  restaurantId         String              @map("restaurant_id") @db.Uuid
  branchId             String              @map("branch_id") @db.Uuid
  checkoutSessionId    String              @unique @map("checkout_session_id") @db.Uuid
  status               OrderStatus
  refundStatus         OrderRefundStatus   @default(NONE) @map("refund_status")
  paymentMethod        PaymentMethod       @map("payment_method")
  currency             String              @default("INR") @db.Char(3)
  itemsSubtotalAmount  Int                 @map("items_subtotal_amount")
  discountTotalAmount  Int                 @default(0) @map("discount_total_amount")
  feesTotalAmount      Int                 @default(0) @map("fees_total_amount")
  taxTotalAmount       Int                 @default(0) @map("tax_total_amount")
  tipAmount            Int                 @default(0) @map("tip_amount")
  walletAppliedAmount  Int                 @default(0) @map("wallet_applied_amount")
  totalAmount          Int                 @map("total_amount")
  payableAmount        Int                 @map("payable_amount")
  feeScheduleId        String              @map("fee_schedule_id") @db.Uuid
  /// Commission rate captured at creation (BR-COMM-001).
  commissionRateBps    Int                 @map("commission_rate_bps")
  couponId             String?             @map("coupon_id") @db.Uuid
  deliveryOtpHash      Bytes?              @map("delivery_otp_hash")
  deliveryOtpAttempts  Int                 @default(0) @map("delivery_otp_attempts")
  contactless          Boolean             @default(false)
  deliveryInstructions String?             @map("delivery_instructions") @db.VarChar(200)
  cookingInstructions  String?             @map("cooking_instructions") @db.VarChar(250)
  noCutlery            Boolean             @default(false) @map("no_cutlery")
  contactName          String              @map("contact_name") @db.VarChar(80)
  contactPhone         String              @map("contact_phone") @db.VarChar(16)
  prepMinutes          Int?                @map("prep_minutes")
  failureReason        OrderFailureReason? @map("failure_reason")
  placedAt             DateTime?           @map("placed_at") @db.Timestamptz(3)
  acceptedAt           DateTime?           @map("accepted_at") @db.Timestamptz(3)
  preparingAt          DateTime?           @map("preparing_at") @db.Timestamptz(3)
  readyBy              DateTime?           @map("ready_by") @db.Timestamptz(3)
  readyAt              DateTime?           @map("ready_at") @db.Timestamptz(3)
  pickedUpAt           DateTime?           @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt          DateTime?           @map("delivered_at") @db.Timestamptz(3)
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  etaMinAt             DateTime?           @map("eta_min_at") @db.Timestamptz(3)
  etaMaxAt             DateTime?           @map("eta_max_at") @db.Timestamptz(3)
  version              Int                 @default(0)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                  @relation(fields: [userId], references: [id])
  restaurant       Restaurant            @relation(fields: [restaurantId], references: [id])
  branch           Branch                @relation(fields: [branchId], references: [id])
  checkoutSession  CheckoutSession       @relation(fields: [checkoutSessionId], references: [id])
  feeSchedule      FeeSchedule           @relation(fields: [feeScheduleId], references: [id])
  coupon           Coupon?               @relation(fields: [couponId], references: [id], onDelete: Restrict)
  address          OrderAddress?
  items            OrderItem[]
  priceComponents  OrderPriceComponent[]
  statusHistory    OrderStatusHistory[]
  cancellation     OrderCancellation?
  issues           OrderIssue[]
  invoices         Invoice[]
  couponRedemption CouponRedemption?
  payments         Payment[]
  refunds          Refund[]
  delivery         Delivery?
  reviews          Review[]
  supportTickets   SupportTicket[]
  disputes         Dispute[]
  complaints       Complaint[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([branchId, status, createdAt])
  @@index([restaurantId, createdAt])
  @@map("orders")
}

/// Delivery address as it was at order time (immutable).
model OrderAddress {
  orderId         String                               @id @map("order_id") @db.Uuid
  line1           String                               @db.VarChar(200)
  line2           String?                              @db.VarChar(200)
  landmark        String?                              @db.VarChar(120)
  area            String                               @db.VarChar(120)
  city            String                               @db.VarChar(80)
  state           String                               @db.VarChar(80)
  pincode         String                               @db.Char(6)
  location        Unsupported("geography(Point,4326)")
  sourceAddressId String?                              @map("source_address_id") @db.Uuid

  order         Order            @relation(fields: [orderId], references: [id])
  sourceAddress CustomerAddress? @relation(fields: [sourceAddressId], references: [id], onDelete: Restrict)

  @@map("order_addresses")
}

/// Item snapshot: name and prices as charged (immutable, SRS §15.6).
model OrderItem {
  id                 String        @id @default(uuid(7)) @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  foodItemId         String        @map("food_item_id") @db.Uuid
  itemName           String        @map("item_name") @db.VarChar(120)
  variantName        String?       @map("variant_name") @db.VarChar(60)
  dietaryMarker      DietaryMarker @map("dietary_marker")
  unitPriceAmount    Int           @map("unit_price_amount")
  optionsAmount      Int           @default(0) @map("options_amount")
  itemDiscountAmount Int           @default(0) @map("item_discount_amount")
  quantity           Int
  lineTotalAmount    Int           @map("line_total_amount")
  taxRateBps         Int           @default(0) @map("tax_rate_bps")
  instructions       String?       @db.VarChar(250)

  order       Order             @relation(fields: [orderId], references: [id])
  foodItem    FoodItem          @relation(fields: [foodItemId], references: [id])
  options     OrderItemOption[]
  refundItems RefundItem[]
  issueItems  OrderIssueItem[]

  @@index([orderId])
  @@index([foodItemId])
  @@map("order_items")
}

model OrderItemOption {
  id               String @id @default(uuid(7)) @db.Uuid
  orderItemId      String @map("order_item_id") @db.Uuid
  optionId         String @map("option_id") @db.Uuid
  groupName        String @map("group_name") @db.VarChar(80)
  optionName       String @map("option_name") @db.VarChar(80)
  priceDeltaAmount Int    @map("price_delta_amount")

  orderItem OrderItem           @relation(fields: [orderItemId], references: [id])
  option    CustomizationOption @relation(fields: [optionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_options")
}

/// Signed breakdown lines (discounts negative). Immutable.
model OrderPriceComponent {
  id       String                  @id @default(uuid(7)) @db.Uuid
  orderId  String                  @map("order_id") @db.Uuid
  type     OrderPriceComponentType
  code     String?                 @db.VarChar(40)
  label    String                  @db.VarChar(120)
  amount   Int
  taxCode  TaxCode?                @map("tax_code")
  rateBps  Int?                    @map("rate_bps")
  fundedBy FundedBy                @map("funded_by")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_price_components")
}

/// Order timeline (append-only).
model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?      @db.VarChar(300)
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderCancellation {
  orderId       String            @id @map("order_id") @db.Uuid
  initiatorType ActorType         @map("initiator_type")
  initiatorId   String?           @map("initiator_id") @db.Uuid
  reasonCode    String            @map("reason_code") @db.VarChar(40)
  note          String?           @db.VarChar(300)
  fault         CancellationFault
  feeAmount     Int               @default(0) @map("fee_amount")
  refundAmount  Int               @default(0) @map("refund_amount")
  quoteId       String?           @map("quote_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id])
  initiator User? @relation(fields: [initiatorId], references: [id], onDelete: Restrict)

  @@map("order_cancellations")
}

model OrderIssue {
  id                    String           @id @default(uuid(7)) @db.Uuid
  orderId               String           @map("order_id") @db.Uuid
  type                  OrderIssueType
  description           String           @db.VarChar(1000)
  status                OrderIssueStatus @default(OPEN)
  ticketId              String?          @unique @map("ticket_id") @db.Uuid
  requestedRefundAmount Int              @default(0) @map("requested_refund_amount")
  resolution            String?          @db.VarChar(1000)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  order  Order             @relation(fields: [orderId], references: [id])
  ticket SupportTicket?    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  items  OrderIssueItem[]
  photos OrderIssuePhoto[]

  @@index([orderId])
  @@map("order_issues")
}

model OrderIssueItem {
  issueId     String @map("issue_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int

  issue     OrderIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  orderItem OrderItem  @relation(fields: [orderItemId], references: [id])

  @@id([issueId, orderItemId])
  @@map("order_issue_items")
}

model OrderIssuePhoto {
  issueId String @map("issue_id") @db.Uuid
  fileId  String @map("file_id") @db.Uuid

  issue OrderIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  file  File       @relation(fields: [fileId], references: [id])

  @@id([issueId, fileId])
  @@map("order_issue_photos")
}

/// Tax invoice (BR-ORDER-019). Sequential numbering per issuer series and financial year.
model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  issuer        InvoiceIssuer
  series        String        @db.VarChar(20)
  number        Int
  financialYear String        @map("financial_year") @db.Char(7)
  fileId        String?       @map("file_id") @db.Uuid
  issuedAt      DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])
  file  File? @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([series, financialYear, number])
  @@index([orderId])
  @@map("invoices")
}
