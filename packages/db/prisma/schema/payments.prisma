// Payments, refunds, double-entry ledger, settlements, payouts, reconciliation
// (SRS §11, §15.3.7, ADR-011).

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MOCK
  NONE
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  COLLECTED
}

enum PaymentAttemptStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum RefundDestination {
  SOURCE
  WALLET
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CostBearer {
  PLATFORM
  RESTAURANT
  PARTNER
}

enum LedgerOwnerType {
  CUSTOMER
  RESTAURANT
  PARTNER
  PLATFORM
  ORDER
}

enum LedgerAccountType {
  CUSTOMER_WALLET
  CUSTOMER_WALLET_HOLD
  CUSTOMER_ORDER_LIABILITY
  RESTAURANT_PAYABLE
  PARTNER_PAYABLE
  PARTNER_CASH_IN_HAND
  PLATFORM_REVENUE_COMMISSION
  PLATFORM_REVENUE_FEES
  PLATFORM_PROMO_EXPENSE
  PLATFORM_REFUND_EXPENSE
  PLATFORM_DELIVERY_COST
  GATEWAY_CLEARING
  REFUND_CLEARING
  TAX_PAYABLE
  PAYOUT_CLEARING
  CASH_CLEARING
  BANK
}

enum LedgerTransactionType {
  ORDER_PAYMENT
  ORDER_SETTLEMENT
  REFUND
  WALLET_CREDIT
  WALLET_HOLD
  WALLET_RELEASE
  WALLET_DEBIT
  COD_COLLECTION
  CASH_DEPOSIT
  PARTNER_EARNING
  PAYOUT
  ADJUSTMENT
  INCENTIVE
  CANCELLATION_FEE
}

enum CreditSource {
  REFUND
  PROMO
  GOODWILL
}

enum SettlementStatus {
  OPEN
  FINALIZED
  PAID
}

enum PayeeType {
  RESTAURANT
  PARTNER
}

enum PayoutBatchStatus {
  DRAFT
  APPROVED
  PROCESSING
  PAID
  PARTIALLY_FAILED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum ReconciliationExceptionType {
  MISSING_INTERNAL
  MISSING_PROVIDER
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  ORPHAN_CAPTURE
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

/// SQL: CHECK refunded ≤ captured ≤ amount; partial unique (provider, provider_order_id).
model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  method            PaymentMethod
  provider          PaymentProvider
  providerOrderId   String?         @map("provider_order_id") @db.VarChar(100)
  amount            Int
  currency          String          @default("INR") @db.Char(3)
  status            PaymentStatus   @default(CREATED)
  capturedAmount    Int             @default(0) @map("captured_amount")
  refundedAmount    Int             @default(0) @map("refunded_amount")
  capturedAt        DateTime?       @map("captured_at") @db.Timestamptz(3)
  /// Masked instrument as returned by the provider, e.g. "UPI • ab***@okicici".
  instrumentSummary String?         @map("instrument_summary") @db.VarChar(80)
  failureCode       String?         @map("failure_code") @db.VarChar(60)
  failureReason     String?         @map("failure_reason") @db.VarChar(300)
  version           Int             @default(0)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order    Order            @relation(fields: [orderId], references: [id])
  attempts PaymentAttempt[]
  refunds  Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                String               @id @default(uuid(7)) @db.Uuid
  paymentId         String               @map("payment_id") @db.Uuid
  providerPaymentId String?              @unique @map("provider_payment_id") @db.VarChar(100)
  status            PaymentAttemptStatus @default(CREATED)
  amount            Int
  methodDetail      String?              @map("method_detail") @db.VarChar(40)
  errorCode         String?              @map("error_code") @db.VarChar(60)
  raw               Json?
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_attempts")
}

/// Every verified webhook, stored before processing (FR-PAY-004). Unique per provider event.
model PaymentWebhookEvent {
  id               String                  @id @default(uuid(7)) @db.Uuid
  provider         PaymentProvider
  eventId          String                  @map("event_id") @db.VarChar(100)
  eventType        String                  @map("event_type") @db.VarChar(60)
  signatureValid   Boolean                 @map("signature_valid")
  payload          Json
  receivedAt       DateTime                @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz(3)
  processingStatus WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  error            String?                 @db.VarChar(500)

  @@unique([provider, eventId])
  @@index([processingStatus])
  @@map("payment_webhook_events")
}

model Refund {
  id               String            @id @default(uuid(7)) @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  paymentId        String?           @map("payment_id") @db.Uuid
  amount           Int
  destination      RefundDestination
  reasonCode       String            @map("reason_code") @db.VarChar(40)
  note             String?           @db.VarChar(500)
  initiatorType    ActorType         @map("initiator_type")
  initiatorId      String?           @map("initiator_id") @db.Uuid
  costBearer       CostBearer        @map("cost_bearer")
  status           RefundStatus
  providerRefundId String?           @unique @map("provider_refund_id") @db.VarChar(100)
  attempts         Int               @default(0)
  nextAttemptAt    DateTime?         @map("next_attempt_at") @db.Timestamptz(3)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(3)
  version          Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     Order        @relation(fields: [orderId], references: [id])
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  initiator User?        @relation(fields: [initiatorId], references: [id], onDelete: Restrict)
  items     RefundItem[]
  disputes  Dispute[]

  @@index([orderId])
  @@index([status, nextAttemptAt])
  @@map("refunds")
}

model RefundItem {
  refundId    String @map("refund_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int
  amount      Int

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@id([refundId, orderItemId])
  @@map("refund_items")
}

/// SQL: unique (owner_type, coalesce(owner_id), type, currency); CHECK balance ≥ 0
/// for customer wallet accounts.
model LedgerAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  ownerType LedgerOwnerType   @map("owner_type")
  ownerId   String?           @map("owner_id") @db.Uuid
  type      LedgerAccountType
  currency  String            @default("INR") @db.Char(3)
  /// Cached sum of entries, updated in the same transaction (ADR-011).
  balance   BigInt            @default(0)
  version   Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries    LedgerEntry[]
  creditLots WalletCreditLot[]

  @@index([ownerType, ownerId])
  @@map("ledger_accounts")
}

/// Immutable journal header. SQL: trigger enforces Σ entries = 0 at commit;
/// UPDATE/DELETE rejected.
model LedgerTransaction {
  id             String                @id @default(uuid(7)) @db.Uuid
  type           LedgerTransactionType
  referenceType  String                @map("reference_type") @db.VarChar(40)
  referenceId    String                @map("reference_id") @db.Uuid
  /// Distinguishes several postings of the same type for one reference.
  idempotencyKey String                @default("") @map("idempotency_key") @db.VarChar(80)
  description    String                @db.VarChar(300)
  createdBy      String?               @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  creator User?         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@unique([type, referenceType, referenceId, idempotencyKey])
  @@map("ledger_transactions")
}

/// Signed amount: positive = debit, negative = credit. Immutable.
model LedgerEntry {
  id            String   @id @default(uuid(7)) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  amount        BigInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// Wallet credit grants with expiry (BR-WALLET-002/003).
model WalletCreditLot {
  id        String       @id @default(uuid(7)) @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  source    CreditSource
  amount    Int
  remaining Int
  expiresAt DateTime?    @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, expiresAt])
  @@map("wallet_credit_lots")
}

model RestaurantSettlement {
  id                String           @id @default(uuid(7)) @db.Uuid
  restaurantId      String           @map("restaurant_id") @db.Uuid
  periodStart       DateTime         @map("period_start") @db.Timestamptz(3)
  periodEnd         DateTime         @map("period_end") @db.Timestamptz(3)
  grossAmount       BigInt           @map("gross_amount")
  commissionAmount  BigInt           @map("commission_amount")
  discountsAmount   BigInt           @map("discounts_amount")
  taxesAmount       BigInt           @map("taxes_amount")
  adjustmentsAmount BigInt           @map("adjustments_amount")
  netAmount         BigInt           @map("net_amount")
  status            SettlementStatus @default(OPEN)
  payoutId          String?          @unique @map("payout_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  payout     Payout?    @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, periodStart])
  @@map("restaurant_settlements")
}

model PayoutBatch {
  id          String            @id @default(uuid(7)) @db.Uuid
  type        PayeeType
  periodStart DateTime          @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime          @map("period_end") @db.Timestamptz(3)
  status      PayoutBatchStatus @default(DRAFT)
  createdBy   String?           @map("created_by") @db.Uuid
  approvedBy  String?           @map("approved_by") @db.Uuid
  approvedAt  DateTime?         @map("approved_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator  User?    @relation("PayoutBatchCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approver User?    @relation("PayoutBatchApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  payouts  Payout[]

  @@unique([type, periodStart])
  @@map("payout_batches")
}

/// One payee per line. SQL: CHECK exactly one of restaurant/partner set,
/// matching payee_type; CHECK amount > 0; unique (batch, payee).
model Payout {
  id                      String       @id @default(uuid(7)) @db.Uuid
  batchId                 String       @map("batch_id") @db.Uuid
  payeeType               PayeeType    @map("payee_type")
  restaurantId            String?      @map("restaurant_id") @db.Uuid
  partnerId               String?      @map("partner_id") @db.Uuid
  restaurantBankAccountId String?      @map("restaurant_bank_account_id") @db.Uuid
  partnerBankAccountId    String?      @map("partner_bank_account_id") @db.Uuid
  amount                  BigInt
  status                  PayoutStatus @default(PENDING)
  utr                     String?      @db.VarChar(40)
  failureReason           String?      @map("failure_reason") @db.VarChar(300)
  paidAt                  DateTime?    @map("paid_at") @db.Timestamptz(3)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch                 PayoutBatch            @relation(fields: [batchId], references: [id])
  restaurant            Restaurant?            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  partner               DeliveryPartner?       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  restaurantBankAccount RestaurantBankAccount? @relation(fields: [restaurantBankAccountId], references: [id], onDelete: Restrict)
  partnerBankAccount    PartnerBankAccount?    @relation(fields: [partnerBankAccountId], references: [id], onDelete: Restrict)
  settlement            RestaurantSettlement?

  @@index([batchId])
  @@index([restaurantId])
  @@index([partnerId])
  @@map("payouts")
}

model ReconciliationRun {
  id             String          @id @default(uuid(7)) @db.Uuid
  provider       PaymentProvider
  runDate        DateTime        @map("run_date") @db.Date
  paymentsCount  Int             @default(0) @map("payments_count")
  refundsCount   Int             @default(0) @map("refunds_count")
  exceptionCount Int             @default(0) @map("exception_count")
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  exceptions ReconciliationException[]

  @@unique([provider, runDate])
  @@map("reconciliation_runs")
}

model ReconciliationException {
  id         String                      @id @default(uuid(7)) @db.Uuid
  runId      String                      @map("run_id") @db.Uuid
  type       ReconciliationExceptionType
  refType    String                      @map("ref_type") @db.VarChar(40)
  refId      String                      @map("ref_id") @db.VarChar(100)
  details    Json
  status     ExceptionStatus             @default(OPEN)
  resolution String?                     @db.VarChar(500)
  resolvedBy String?                     @map("resolved_by") @db.Uuid
  resolvedAt DateTime?                   @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  run ReconciliationRun @relation(fields: [runId], references: [id])

  @@index([status])
  @@map("reconciliation_exceptions")
}
