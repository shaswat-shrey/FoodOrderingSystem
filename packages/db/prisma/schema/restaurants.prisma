// Restaurants (brands), branches, onboarding, staff (SRS §15.3.3, ADR-013, ADR-002).

enum EntityType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  OTHER
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RestaurantDocumentType {
  FSSAI
  PAN
  GST
  BANK_PROOF
  MENU
  OTHER
}

enum BankAccountStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum ChangeRequestType {
  LEGAL_NAME
  PAN
  GSTIN
  FSSAI
  BANK_ACCOUNT
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BranchStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PackagingFeeMode {
  NONE
  PER_ITEM
  PER_ORDER
}

enum BranchStatusEventType {
  OPENED
  CLOSED
  PAUSED
  RESUMED
  AUTO_PAUSED
  SUSPENDED
  UNSUSPENDED
}

enum RestaurantRole {
  OWNER
  MANAGER
  ORDER_MANAGER
  KITCHEN
  STAFF
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Brand / legal entity owning the menu. SQL: trigram index on brand_name,
/// search_vector maintained by trigger.
model Restaurant {
  id               String                   @id @default(uuid(7)) @db.Uuid
  brandName        String                   @map("brand_name") @db.VarChar(120)
  slug             String                   @unique @db.VarChar(140)
  legalName        String                   @map("legal_name") @db.VarChar(200)
  entityType       EntityType               @map("entity_type")
  /// AES-256-GCM ciphertext; only the last 4 characters are stored in clear.
  panEncrypted     Bytes?                   @map("pan_encrypted")
  panLast4         String?                  @map("pan_last4") @db.Char(4)
  gstin            String?                  @db.Char(15)
  fssaiNumber      String?                  @map("fssai_number") @db.Char(14)
  fssaiExpiresOn   DateTime?                @map("fssai_expires_on") @db.Date
  description      String?                  @db.VarChar(1000)
  contactEmail     String?                  @map("contact_email") @db.Citext
  contactPhone     String?                  @map("contact_phone") @db.VarChar(16)
  logoFileId       String?                  @map("logo_file_id") @db.Uuid
  coverFileId      String?                  @map("cover_file_id") @db.Uuid
  onboardingStatus OnboardingStatus         @default(DRAFT) @map("onboarding_status")
  submissionCount  Int                      @default(0) @map("submission_count")
  status           AccountStatus            @default(ACTIVE)
  codEnabled       Boolean                  @default(true) @map("cod_enabled")
  pureVeg          Boolean                  @default(false) @map("pure_veg")
  ratingAvgBps     Int?                     @map("rating_avg_bps")
  ratingCount      Int                      @default(0) @map("rating_count")
  searchVector     Unsupported("tsvector")? @map("search_vector")
  approvedAt       DateTime?                @map("approved_at") @db.Timestamptz(3)
  approvedBy       String?                  @map("approved_by") @db.Uuid
  rejectedReason   String?                  @map("rejected_reason") @db.VarChar(1000)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  logoFile            File?                          @relation("RestaurantLogo", fields: [logoFileId], references: [id])
  coverFile           File?                          @relation("RestaurantCover", fields: [coverFileId], references: [id])
  approvedByUser      User?                          @relation("RestaurantApprovedBy", fields: [approvedBy], references: [id])
  applicationReviews  RestaurantApplicationReview[]
  documents           RestaurantDocument[]
  bankAccounts        RestaurantBankAccount[]
  changeRequests      RestaurantChangeRequest[]
  cuisines            RestaurantCuisine[]
  branches            Branch[]
  members             RestaurantMember[]
  invitations         RestaurantInvitation[]
  commissionOverrides RestaurantCommissionOverride[]
  menuCategories      MenuCategory[]
  foodItems           FoodItem[]
  customizationGroups CustomizationGroup[]
  favorites           FavoriteRestaurant[]
  couponRestaurants   CouponRestaurant[]
  promotions          Promotion[]
  collectionItems     CollectionItem[]
  orders              Order[]
  settlements         RestaurantSettlement[]
  payouts             Payout[]
  reviews             Review[]

  @@index([onboardingStatus])
  @@index([status])
  @@index([brandName(ops: raw("gin_trgm_ops"))], map: "restaurants_brand_name_trgm", type: Gin)
  @@index([searchVector], map: "restaurants_search_vector_gin", type: Gin)
  @@map("restaurants")
}

/// Immutable record of each review decision on an application.
model RestaurantApplicationReview {
  id           String         @id @default(uuid(7)) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  submissionNo Int            @map("submission_no")
  reviewerId   String         @map("reviewer_id") @db.Uuid
  decision     ReviewDecision
  /// Field or document key → reviewer comment.
  comments     Json           @default("{}")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  @@index([restaurantId])
  @@map("restaurant_application_reviews")
}

model RestaurantDocument {
  id           String                 @id @default(uuid(7)) @db.Uuid
  restaurantId String                 @map("restaurant_id") @db.Uuid
  type         RestaurantDocumentType
  fileId       String                 @map("file_id") @db.Uuid
  status       DocumentStatus         @default(PENDING)
  expiresOn    DateTime?              @map("expires_on") @db.Date
  reviewerNote String?                @map("reviewer_note") @db.VarChar(500)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  file       File       @relation(fields: [fileId], references: [id])

  @@index([restaurantId, type])
  @@map("restaurant_documents")
}

/// SQL: partial unique — one VERIFIED account per restaurant.
model RestaurantBankAccount {
  id                     String            @id @default(uuid(7)) @db.Uuid
  restaurantId           String            @map("restaurant_id") @db.Uuid
  holderName             String            @map("holder_name") @db.VarChar(120)
  accountNumberEncrypted Bytes             @map("account_number_encrypted")
  accountLast4           String            @map("account_last4") @db.Char(4)
  ifsc                   String            @db.Char(11)
  status                 BankAccountStatus @default(PENDING_VERIFICATION)
  verifiedAt             DateTime?         @map("verified_at") @db.Timestamptz(3)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  payouts    Payout[]

  @@index([restaurantId])
  @@map("restaurant_bank_accounts")
}

model RestaurantChangeRequest {
  id               String              @id @default(uuid(7)) @db.Uuid
  restaurantId     String              @map("restaurant_id") @db.Uuid
  type             ChangeRequestType
  /// Encrypted JSON of the requested values (may contain bank/PAN data).
  payloadEncrypted Bytes               @map("payload_encrypted")
  status           ChangeRequestStatus @default(PENDING)
  requestedBy      String              @map("requested_by") @db.Uuid
  decidedBy        String?             @map("decided_by") @db.Uuid
  decidedAt        DateTime?           @map("decided_at") @db.Timestamptz(3)
  reason           String?             @db.VarChar(500)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  requester  User       @relation("ChangeRequestedBy", fields: [requestedBy], references: [id])
  decider    User?      @relation("ChangeDecidedBy", fields: [decidedBy], references: [id])

  @@index([status])
  @@index([restaurantId])
  @@map("restaurant_change_requests")
}

model Cuisine {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(60)
  imageFileId String?  @map("image_file_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  imageFile   File?               @relation("CuisineImage", fields: [imageFileId], references: [id])
  restaurants RestaurantCuisine[]

  @@map("cuisines")
}

model RestaurantCuisine {
  restaurantId String  @map("restaurant_id") @db.Uuid
  cuisineId    String  @map("cuisine_id") @db.Uuid
  isPrimary    Boolean @default(false) @map("is_primary")
  position     Int     @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine    Cuisine    @relation(fields: [cuisineId], references: [id])

  @@id([restaurantId, cuisineId])
  @@index([cuisineId])
  @@map("restaurant_cuisines")
}

/// Orderable outlet. SQL: GiST(location), CHECK radius 500–15000 m, CHECK prep 5–90 min.
model Branch {
  id                  String                               @id @default(uuid(7)) @db.Uuid
  restaurantId        String                               @map("restaurant_id") @db.Uuid
  zoneId              String                               @map("zone_id") @db.Uuid
  name                String                               @db.VarChar(120)
  line1               String                               @db.VarChar(200)
  line2               String?                              @db.VarChar(200)
  area                String                               @db.VarChar(120)
  city                String                               @db.VarChar(80)
  state               String                               @db.VarChar(80)
  pincode             String                               @db.Char(6)
  location            Unsupported("geography(Point,4326)")
  timezone            String                               @default("Asia/Kolkata") @db.VarChar(40)
  phone               String?                              @db.VarChar(16)
  deliveryRadiusM     Int                                  @default(5000) @map("delivery_radius_m")
  status              BranchStatus                         @default(PENDING_APPROVAL)
  /// Manual "online" toggle for today (FR-REST-014).
  isOpenManual        Boolean                              @default(false) @map("is_open_manual")
  pausedUntil         DateTime?                            @map("paused_until") @db.Timestamptz(3)
  pauseReason         String?                              @map("pause_reason") @db.VarChar(200)
  defaultPrepMinutes  Int                                  @default(20) @map("default_prep_minutes")
  rushExtraMinutes    Int                                  @default(0) @map("rush_extra_minutes")
  rushUntil           DateTime?                            @map("rush_until") @db.Timestamptz(3)
  minOrderAmount      Int                                  @default(0) @map("min_order_amount")
  maxOrderAmount      Int?                                 @map("max_order_amount")
  priceForTwo         Int?                                 @map("price_for_two")
  packagingFeeMode    PackagingFeeMode                     @default(NONE) @map("packaging_fee_mode")
  packagingFeeAmount  Int                                  @default(0) @map("packaging_fee_amount")
  acceptTimeoutStreak Int                                  @default(0) @map("accept_timeout_streak")
  menuVersion         Int                                  @default(0) @map("menu_version")
  ratingAvgBps        Int?                                 @map("rating_avg_bps")
  ratingCount         Int                                  @default(0) @map("rating_count")
  avgPrepMinutes14d   Int?                                 @map("avg_prep_minutes_14d")
  version             Int                                  @default(0)
  createdAt           DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?                            @map("deleted_at") @db.Timestamptz(3)

  restaurant         Restaurant                   @relation(fields: [restaurantId], references: [id])
  zone               Zone                         @relation(fields: [zoneId], references: [id])
  operatingHours     BranchOperatingHour[]
  holidays           BranchHoliday[]
  statusEvents       BranchStatusEvent[]
  memberBranches     RestaurantMemberBranch[]
  invitationBranches RestaurantInvitationBranch[]
  itemAvailability   BranchItemAvailability[]
  optionAvailability BranchOptionAvailability[]
  itemStock          BranchItemStock[]
  carts              Cart[]
  orders             Order[]
  deliveries         Delivery[]
  promotionBranches  PromotionBranch[]
  reviews            Review[]
  hourlyAnalytics    AnalyticsBranchHourly[]

  @@index([restaurantId])
  @@index([zoneId, status])
  @@index([location], map: "branches_location_gix", type: Gist)
  @@map("branches")
}

/// Weekly slots in branch-local time. SQL: max 3 slots per weekday (trigger), CHECK weekday 0–6.
model BranchOperatingHour {
  id       String   @id @default(uuid(7)) @db.Uuid
  branchId String   @map("branch_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  weekday  Int      @db.SmallInt
  opensAt  DateTime @map("opens_at") @db.Time(0)
  closesAt DateTime @map("closes_at") @db.Time(0)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, weekday])
  @@map("branch_operating_hours")
}

model BranchHoliday {
  id        String   @id @default(uuid(7)) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, startsAt])
  @@map("branch_holidays")
}

/// Append-only open/close/pause log.
model BranchStatusEvent {
  id        String                @id @default(uuid(7)) @db.Uuid
  branchId  String                @map("branch_id") @db.Uuid
  event     BranchStatusEventType
  reason    String?               @db.VarChar(200)
  actorId   String?               @map("actor_id") @db.Uuid
  until     DateTime?             @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([branchId, createdAt])
  @@map("branch_status_events")
}

/// Restaurant-scoped role (ADR-002). SQL: partial unique (restaurant,user) while not
/// REMOVED; single ACTIVE OWNER per restaurant.
model RestaurantMember {
  id           String         @id @default(uuid(7)) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  role         RestaurantRole
  status       MemberStatus   @default(ACTIVE)
  allBranches  Boolean        @default(true) @map("all_branches")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant               @relation(fields: [restaurantId], references: [id])
  user       User                     @relation(fields: [userId], references: [id])
  branches   RestaurantMemberBranch[]

  @@index([userId])
  @@index([restaurantId])
  @@map("restaurant_members")
}

model RestaurantMemberBranch {
  memberId String @map("member_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  member RestaurantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branch Branch           @relation(fields: [branchId], references: [id])

  @@id([memberId, branchId])
  @@index([branchId])
  @@map("restaurant_member_branches")
}

model RestaurantInvitation {
  id           String           @id @default(uuid(7)) @db.Uuid
  restaurantId String           @map("restaurant_id") @db.Uuid
  invitedBy    String           @map("invited_by") @db.Uuid
  phone        String?          @db.VarChar(16)
  email        String?          @db.Citext
  role         RestaurantRole
  allBranches  Boolean          @default(true) @map("all_branches")
  tokenHash    Bytes            @unique @map("token_hash")
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant                   @relation(fields: [restaurantId], references: [id])
  inviter    User                         @relation(fields: [invitedBy], references: [id])
  branches   RestaurantInvitationBranch[]

  @@index([restaurantId, status])
  @@map("restaurant_invitations")
}

model RestaurantInvitationBranch {
  invitationId String @map("invitation_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid

  invitation RestaurantInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  branch     Branch               @relation(fields: [branchId], references: [id])

  @@id([invitationId, branchId])
  @@map("restaurant_invitation_branches")
}

/// Effective-dated default commission (FR-CFG-002). Never updated in place.
model CommissionPlan {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @db.VarChar(80)
  rateBps       Int      @map("rate_bps")
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([effectiveFrom])
  @@map("commission_plans")
}

model RestaurantCommissionOverride {
  id            String   @id @default(uuid(7)) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  rateBps       Int      @map("rate_bps")
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, effectiveFrom])
  @@map("restaurant_commission_overrides")
}
